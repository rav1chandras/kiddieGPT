{
  "manifest_version": 3,
  "name": "KiddieGPT",
  "version": "1.4.0",
  "description": "Smart help. Clear answers. Better learning for kids.",
  "minimum_chrome_version": "114",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "sidePanel",
    "windows"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://kiddiegpt1.vercel.app/*",
    "https://app.kiddiegpt.com/*",
    "https://api.openai.com/*"
  ],
  "action": {
    "default_title": "Open KiddieGPT",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "key": "",
  "externally_connectable": {
    "matches": [
      "https://app.kiddiegpt.com/*",
      "https://kiddiegpt1.vercel.app/*"
    ]
  }
}
